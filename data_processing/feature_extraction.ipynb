    "542 ---> 490 features\n",
    "\n",
    "# Variance filtering\n",
    "\n",
    "We are to drop features that have x % sharing of same values. To prevent overfitting, we should split the dataset. To avoid individual subject's noise, we use subject-safe splitting. To validate the variance filtering, we use group k-fold cross validation."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 11,
   "id": "bb6a0f14",
   "metadata": {},
   "outputs": [],
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Original features: 488\n",
      "Features after Pipeline pruning: 217\n"
     ]
    }
   ],
   "source": [
    "# --- Load & Clean Step (Manual FFT Pruning) ---\n",
    "df = pd.read_csv('../dataset/full.csv')\n",
    "df_cleaned = df.T.drop_duplicates(keep='first').T\n",
    "\n",
    "# Regex drop redundant Fourier transform features\n",
    "total_features = df_cleaned.columns.tolist()\n",
    "fft_patterns = [r\"^f.*-mean\\(\\)\", r\"^f.*-max\\(\\)\", r\"^f.*-min\\(\\)\", r\"^f.*-energy\\(\\)\"]\n",
    "\n",
    "features_to_remove = []\n",
    "for pat in fft_patterns:\n",
    "    features_to_remove.extend([i for i in total_features if re.search(pat, i)])\n",
    "\n",
    "df_cleaned = df_cleaned.drop(columns=list(set(features_to_remove)))\n",
    "\n",
    "# --- Variance & Correlation Filtering Pipeline ---\n",
    "# 2. Define Data and Grouping\n",
    "X = df_cleaned.drop(columns=['Activity', 'subject'], errors='ignore')\n",
    "groups = df_cleaned['subject']\n",
    "\n",
    "# 3. Subject-Safe Split Indexing\n",
    "gss = GroupShuffleSplit(n_splits=1, test_size=0.30, random_state=69)\n",
    "train_idx, _ = next(gss.split(X, groups=groups))\n",
    "\n",
    "# 4. Pipeline Definition\n",
    "pipeline = Pipeline([\n",
    "    ('variance_threshold', VarianceThreshold(threshold=0.01)), # Drop variance < 1%\n",
    "    ('corr_filter', CorrelationFilter(threshold=0.95))        # Drop correlation > 0.95\n",
    "])\n",
    "\n",
    "# 5. Fit Pipeline strictly on Training split\n",
    "pipeline.fit(X.iloc[train_idx])\n",
    "\n",
    "# 6. Transform full feature set\n",
    "X_transformed = pipeline.transform(X)\n",
    "\n",
    "# 7. Extract correct retained feature names (FIXED STEP)\n",
    "vt_step = pipeline.named_steps['variance_threshold']\n",
    "corr_step = pipeline.named_steps['corr_filter']\n",
    "\n",
    "# Get column names after Variance Threshold\n",
    "vt_cols = X.columns[vt_step.get_support()]\n",
    "\n",
    "# Filter vt_cols by positional index using corr_step.to_drop_ (which contains integer column indices)\n",
    "retained_cols = [col for idx, col in enumerate(vt_cols) if idx not in corr_step.to_drop_]\n",
    "\n",
    "# 8. Reconstruct cleaned DataFrame maintaining original row indices\n",
    "df_final = pd.DataFrame(X_transformed, columns=retained_cols, index=df_cleaned.index)\n",
    "\n",
    "# Re-attach target & group columns\n",
    "df_final['Activity'] = df_cleaned['Activity']\n",
    "df_final['subject'] = df_cleaned['subject']\n",
    "\n",
    "# Verification\n",
    "print(f\"Original features: {X.shape[1]}\")\n",
    "print(f\"Features after Pipeline pruning: {df_final.shape[1] - 2}\")\n",
    "\n",
    "# Export\n",
    "df_final.to_csv('../dataset/datasets/full_v5.csv', index=False)"
   ]
  },
