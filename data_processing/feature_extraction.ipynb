   "source": [
    "# 1. Custom Correlation Filter Class\n",
    "class CorrelationFilter(BaseEstimator, TransformerMixin):\n",
    "    def __init__(self, threshold=0.95):\n",
    "        self.threshold = threshold\n",
    "        self.to_drop_ = []\n",
    "\n",
    "    def fit(self, X, y=None):\n",
    "        # Convert input to DataFrame if it is a NumPy array\n",
    "        df_x = pd.DataFrame(X) if not isinstance(X, pd.DataFrame) else X\n",
    "        \n",
    "        corr_matrix = df_x.corr().abs()\n",
    "        upper_tri = corr_matrix.where(\n",
    "            np.triu(np.ones(corr_matrix.shape), k=1).astype(bool)\n",
    "        )\n",
    "        # Store indices/columns that exceed correlation threshold\n",
    "        self.to_drop_ = [\n",
    "            col for col in upper_tri.columns \n",
    "            if any(upper_tri[col] > self.threshold)\n",
    "        ]\n",
    "        return self\n",
    "\n",
    "    def transform(self, X):\n",
    "        df_x = pd.DataFrame(X) if not isinstance(X, pd.DataFrame) else X.copy()\n",
    "        # Drop columns either by name or integer index position\n",
    "        return df_x.drop(columns=self.to_drop_)"
   ]
  },
