   "source": [
    "import pandas as pd\n",
    "import numpy as np\n",
    "import re\n",
    "from sklearn.feature_selection import VarianceThreshold\n",
    "from sklearn.model_selection import GroupShuffleSplit\n",
    "from sklearn.base import BaseEstimator, TransformerMixin\n",
    "\n",
    "# 1. Fixed Custom Correlation Filter Transformer\n",
    "class CorrelationFilter(BaseEstimator, TransformerMixin):\n",
    "    def __init__(self, threshold=0.95):\n",
    "        self.threshold = threshold\n",
    "        self.to_drop_ = []\n",
    "\n",
    "    def fit(self, X, y=None):\n",
    "        df_x = pd.DataFrame(X) if not isinstance(X, pd.DataFrame) else X\n",
    "        \n",
    "        corr_matrix = df_x.corr().abs()\n",
    "        upper_tri = corr_matrix.where(\n",
    "            np.triu(np.ones(corr_matrix.shape), k=1).astype(bool)\n",
    "        )\n",
    "        self.to_drop_ = [\n",
    "            col for col in upper_tri.columns \n",
    "            if any(upper_tri[col] > self.threshold)\n",
    "        ]\n",
    "        return self\n",
    "\n",
    "    def transform(self, X):\n",
    "        df_x = pd.DataFrame(X) if not isinstance(X, pd.DataFrame) else X.copy()\n",
    "        return df_x.drop(columns=self.to_drop_)\n",
    "\n",
    "# --- Tracker & Reporter Helpers ---\n",
    "log_records = []\n",
    "\n",
    "def log_step(stage_num, stage_name, current_count, last_count):\n",
    "    removed = last_count - current_count\n",
    "    pct = (removed / last_count * 100) if last_count > 0 else 0.0\n",
    "    log_records.append({\n",
    "        \"Stage\": stage_num,\n",
    "        \"Operation\": stage_name,\n",
    "        \"Remaining Features\": current_count,\n",
    "        \"Features Removed\": removed,\n",
    "        \"% Reduced (Step)\": f\"{pct:.2f}%\"\n",
    "    })\n",
    "    print(f\"[{stage_num}] {stage_name}: {last_count} -> {current_count} features (Removed {removed}, -{pct:.2f}%)\")\n",
    "\n",
    "\n",
    "# --- Step 0: Load Data ---\n",
    "df = pd.read_csv('../dataset/full.csv')\n",
    "initial_count = df.shape[1] - 2  # Excluding 'Activity' and 'subject'\n",
    "last_count = initial_count\n",
    "\n",
    "print(\"=\" * 70)\n",
    "print(\"FEATURE EXTRACTION & PREPROCESSING TRACKER\")\n",
    "print(\"=\" * 70)\n",
    "print(f\"Initial raw dataset features (excluding metadata): {initial_count}\\n\")\n",
    "\n",
    "\n",
    "# --- Step 1: Global Data Hygiene (Duplicate Columns) ---\n",
    "# df_without_metadata = df.drop(columns=['Activity', 'subject'])\n",
    "df_cleaned = df.T.drop_duplicates(keep='first').T\n",
    "\n",
    "curr_count = df_cleaned.shape[1]\n",
    "log_step(1, \"100% Duplicate Column Removal\", curr_count, last_count)\n",
    "last_count = curr_count\n",
    "\n",
    "df_without_metadata = df.drop(columns=['Activity', 'subject'])\n",
    "df_cleaned = df_without_metadata.T.drop_duplicates(keep='first').T\n",
    "\n",
    "curr_count = df_cleaned.shape[1]\n",
    "log_step(1, \"100% Duplicate Column Removal\", curr_count, last_count)\n",
    "last_count = curr_count\n",
    "\n",
    "# --- Step 2: FFT Regex Pruning ---\n",
    "total_features = df_cleaned.columns.tolist()\n",
    "fft_patterns = [r\"^f.*-mean\\(\\)\", r\"^f.*-max\\(\\)\", r\"^f.*-min\\(\\)\", r\"^f.*-energy\\(\\)\"]\n",
    "\n",
    "features_to_remove = set()\n",
    "for pat in fft_patterns:\n",
    "    features_to_remove.update([i for i in total_features if re.search(pat, i)])\n",
    "\n",
    "df_cleaned = df_cleaned.drop(columns=list(features_to_remove))\n",
    "\n",
    "df_cleaned.to_csv('../dataset/full_wo_fft.csv', index=False)\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "03f800ef",
   "metadata": {},
   "outputs": [],
   "source": [
    "\n",
    "curr_count = df_cleaned.shape[1]\n",
    "log_step(2, \"Redundant FFT Physics/Domain Pruning\", curr_count, last_count)\n",
    "last_count = curr_count\n",
    "\n",
    "# --- Step 3: Separate Predictors and Target/Group ---\n",
    "X = df_cleaned.copy()\n",
    "groups = df['subject']\n",
    "\n",
    "# --- Step 4: Subject-Safe Split Indexing ---\n",
    "gss = GroupShuffleSplit(n_splits=1, test_size=0.30, random_state=69)\n",
    "gss = GroupShuffleSplit(n_splits=1, test_size=0.30, random_state=69)\n",
    "train_idx, _ = next(gss.split(X, groups=groups))\n",
    "\n",
    "\n",
    "# --- Step 5: Statistical Feature Selection ---\n",
    "# Step A: Variance Threshold (< 1%)\n",
    "vt = VarianceThreshold(threshold=0.01)\n",
    "vt.fit(X.iloc[train_idx])\n",
    "\n",
    "vt_cols = X.columns[vt.get_support()]\n",
    "X_vt = pd.DataFrame(vt.transform(X), columns=vt_cols, index=X.index)\n",
    "\n",
    "curr_count = X_vt.shape[1]\n",
    "log_step(3, \"Variance Thresholding (< 1% Var)\", curr_count, last_count)\n",
    "last_count = curr_count\n",
    "\n",
    "# Step B: Correlation Filter (> 0.95)\n",
    "corr_filter = CorrelationFilter(threshold=0.95)\n",
    "corr_filter.fit(X_vt.iloc[train_idx])\n",
    "\n",
    "X_final = corr_filter.transform(X_vt)\n",
    "\n",
    "curr_count = X_final.shape[1]\n",
    "log_step(4, \"High Correlation Filter (> 0.95)\", curr_count, last_count)\n",
    "\n",
    "\n",
    "# --- Step 6: Final Summary & Export ---\n",
    "df_final = pd.DataFrame(X_final, index=df_cleaned.index)\n",
    "df_final['Activity'] = df['Activity']\n",
    "df_final['subject'] = df['subject']\n",
    "\n",
    "total_removed = initial_count - curr_count\n",
    "total_pct = (total_removed / initial_count) * 100\n",
    "\n",
    "print(\"\\n\" + \"=\" * 70)\n",
    "print(\"PIPELINE REDUCTION SUMMARY TABLE\")\n",
    "print(\"=\" * 70)\n",
    "summary_df = pd.DataFrame(log_records)\n",
    "print(summary_df.to_string(index=False))\n",
    "\n",
    "print(\"-\" * 70)\n",
    "print(f\"TOTAL PREDICTORS REMOVED : {total_removed} features\")\n",
    "print(f\"OVERALL FEATURE REDUCTION: {total_pct:.2f}% (from {initial_count} down to {curr_count})\")\n",
    "print(\"=\" * 70)\n",
    "\n",
    "# Export final dataset\n",
    "df_final.to_csv('../dataset/full_v4_2_2.csv', index=False)"
   ]
  },
